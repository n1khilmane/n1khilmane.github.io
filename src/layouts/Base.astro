---
import "@fontsource-variable/geist";
import "@fontsource-variable/geist-mono";
import "@fontsource-variable/newsreader/opsz.css";
import "@fontsource-variable/newsreader/opsz-italic.css";
import "../styles/global.css";
import { site, type Mode } from "../data/site";
import Palette from "../components/Palette.astro";

interface Props { title?: string; description?: string; noindex?: boolean; mode?: Mode; home?: boolean; og?: string }
const { title, description = site.bio.work, noindex = false, mode, home = false, og = "/og/index.png" } = Astro.props;
const ogUrl = new URL(og, site.url);
const fullTitle = title ? `${title} · ${site.name}` : site.name;
const canonical = new URL(Astro.url.pathname, site.url);
const year = new Date().getFullYear();
---
<!doctype html>
<html lang="en" data-mode={mode ?? "work"} data-fixed={mode ? "" : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogUrl} />
    <meta name="twitter:site" content="@n1khilmane" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={site.name} href="/rss.xml" />
    <script is:inline>
      (function () {
        var r = document.documentElement;
        try { var t = localStorage.getItem("theme"); if (t === "light" || t === "dark") r.dataset.theme = t; } catch (e) {}
        if (r.hasAttribute("data-fixed")) return;
        var m = new URLSearchParams(location.search).get("mode");
        if (m !== "work" && m !== "life") { try { m = localStorage.getItem("mode"); } catch (e) {} }
        if (m === "life") r.dataset.mode = "life";
      })();
    </script>
  </head>
  <body>
    <main class="wrap">
      <div class="topbar mono">
        {home ? <span></span> : <a href="/">← {site.name}</a>}
        <span class="tr">
          <span class="clock" data-tz={site.tz} title={`Local time, ${site.city}`}>{site.city}</span>
          <button type="button" class="kbtn mono" data-open-palette title="Command menu"><kbd>⌘K</kbd><span class="sr"> command menu</span></button>
        </span>
      </div>
      <slot />
      <footer class="site mono">
        <span>© {year} {site.name}</span>
        <span class="foot-r">
          {home && <span class="hint"><kbd>w</kbd> / <kbd>l</kbd> to switch</span>}
          <a href="/rss.xml">rss</a>
          <a href="/archive">archive</a>
        </span>
      </footer>
    </main>
    <Palette />
    <script is:inline>
      (function () {
        var c = document.querySelector(".clock");
        if (c) {
          var f = new Intl.DateTimeFormat("en-US", { hour: "numeric", minute: "2-digit", timeZone: c.dataset.tz });
          var city = c.textContent;
          var tick = function () { c.textContent = city + " · " + f.format(new Date()).toLowerCase(); };
          tick(); setInterval(tick, 30000);
        }
        if ("serviceWorker" in navigator) {
          navigator.serviceWorker.getRegistrations().then(function (rs) { rs.forEach(function (r) { r.unregister(); }); });
        }
      })();
    </script>
  </body>
</html>

<style>
  .foot-r { display: flex; gap: 1.25rem; align-items: center; }
  .tr { display: flex; gap: 0.9rem; align-items: center; }
  .kbtn { background: none; border: 0; padding: 0; cursor: pointer; color: var(--faint); }
  .kbtn kbd { font: inherit; border: 1px solid var(--line); border-radius: 5px; padding: 0.05rem 0.35rem; }
  .kbtn:hover kbd { color: var(--accent); border-color: var(--accent); }
  .hint { display: none; }
  @media (hover: hover) and (pointer: fine) { .hint { display: inline; } }
</style>
