---
import Base from "../layouts/Base.astro";
import { experience, education, research, other } from "../data/archive";
---
<Base title="Archive" description="Older work, research and writing." noindex mode="work">
  <h1 class="display">Archive</h1>
  <p class="muted lede">Older work, 2017–2023.</p>

  <section class="rowgrid">
    <h2 class="k">experience</h2>
    <ul class="list">
      {experience.map((e) => (
        <li>
          <div class="row"><strong>{e.role}, {e.org}</strong><span class="mono when">{e.when}</span></div>
          <p class="muted">{e.note}</p>
        </li>
      ))}
    </ul>
  </section>

  <section class="rowgrid">
    <h2 class="k">education</h2>
    <ul class="list">
      {education.map((e) => (
        <li>
          <div class="row"><strong>{e.school}</strong><span class="mono when">{e.when}</span></div>
          <p class="muted">{e.degree}. {e.note}</p>
        </li>
      ))}
    </ul>
  </section>

  <section class="rowgrid">
    <h2 class="k">research</h2>
    <ul class="list">
      {research.map((r) => (
        <li>
          <strong>{r.title}</strong>
          <p class="muted">{r.note}</p>
          <p class="mono links">{r.links.map((l) => <a href={l.href}>{l.label} ↗</a>)}</p>
        </li>
      ))}
    </ul>
  </section>

  <section class="rowgrid">
    <h2 class="k">other</h2>
    <ul class="list">
      {other.map((o) => (
        <li>
          <a href={o.href}><strong>{o.title}</strong> ↗</a>
          <p class="muted">{o.note}</p>
        </li>
      ))}
    </ul>
  </section>
</Base>

<style>
  h1 { font-size: clamp(1.75rem, 5vw, 2.2rem); margin: 4.5rem 0 0.25rem; }
  .lede { margin: 0; }
  .list { list-style: none; margin: 0; padding: 0; display: grid; gap: 1.25rem; }
  .list p { margin: 0.2rem 0 0; font-size: 0.9375rem; }
  .list strong { font-weight: 600; }
  .list a { text-decoration: none; }
  .row { display: flex; justify-content: space-between; gap: 1rem; align-items: baseline; flex-wrap: wrap; }
  .when { color: var(--faint); }
  .links { display: flex; gap: 1rem; margin-top: 0.4rem !important; }
  .links a { color: var(--muted); }
</style>
