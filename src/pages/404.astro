---
import Base from "../layouts/Base.astro";
import GraphArt from "../components/GraphArt.astro";
---
<Base title="Not found" noindex>
  <h1 class="display">Lost the thread.</h1>
  <p class="muted">This page doesn't exist. <a href="/">Go home</a>, or press <kbd class="mono">/</kbd> to search.</p>
  <div class="art-wrap"><GraphArt label="404" seed={404} /></div>
</Base>

<style>
  h1 { font-size: clamp(1.75rem, 5vw, 2.2rem); margin: 4.5rem 0 0.5rem; }
  kbd { border: 1px solid var(--line); border-radius: 4px; padding: 0 .3rem; }
  .art-wrap { margin-top: 2.5rem; aspect-ratio: 2 / 1; border: 1px solid var(--line); border-radius: 14px; overflow: hidden; background: var(--accent-soft); }
</style>
