---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import { site, projects, type Mode } from "../data/site";
import { getPosts, readTime, fmtDate } from "../lib";
import photo from "../assets/nikhil.jpg";
import GraphArt from "../components/GraphArt.astro";

const posts = await getPosts();
const modes: Mode[] = ["work", "life"];
const emptyPosts: Record<Mode, string> = { work: "First post soon.", life: "Nothing here yet." };
---
<Base home>
  <header class="hero">
    <Image src={photo} alt="Nikhil Mane" width={176} height={176} class="photo rise" loading="eager" style="--i:0" />
    <div class="who">
      <h1 class="display rise" style="--i:1"><span class="first">{site.name.split(" ")[0]}</span> <span class="last">{site.name.split(" ").slice(1).join(" ")}</span></h1>
      <div class="toggle mono rise" style="--i:2" role="group" aria-label="View">
        <button type="button" data-set="work">work</button>
        <button type="button" data-set="life">life</button>
        <span class="pill" aria-hidden="true"></span>
      </div>
    </div>
  </header>

  {modes.map((m) => {
    const list = posts.filter((p) => p.data.mode === m);
    const built = projects.filter((p) => p.mode === m);
    return (
      <div data-show={m}>
        <section class="rowgrid rise" style="--i:3">
          <h2 class="k">about</h2>
          <div>
            <p class="bio">{site.bio[m]}</p>
            <nav class="links mono" aria-label="Elsewhere">
              {site.links.map((l) => <a href={l.href} rel="me">{l.label}</a>)}
            </nav>
          </div>
        </section>

        <section class="rowgrid rise" style="--i:4">
          <h2 class="k">writing</h2>
          {list.length === 0 ? (
            <p class="muted empty">{emptyPosts[m]}</p>
          ) : (
            <ul class="posts">
              {list.map((p) => (
                <li>
                  <a href={`/posts/${p.id}/`}>
                    <span class="t">{p.data.title}</span>
                    <span class="dots" aria-hidden="true"></span>
                    <span class="mono meta">{readTime(p.body)}m · <time datetime={p.data.date.toISOString()}>{fmtDate(p.data.date)}</time></span>
                  </a>
                  {p.data.description && <p class="desc muted">{p.data.description}</p>}
                </li>
              ))}
            </ul>
          )}
        </section>

        {built.length > 0 && (
          <section class="rowgrid rise" style="--i:5">
            <h2 class="k">building</h2>
            <div class="cards">
              {built.map((p) => {
                const Tag = p.href ? "a" : "div";
                return (
                  <Tag class="card" href={p.href}>
                    <div class="thumb">
                      {p.thumb ? <Image src={p.thumb} alt="" width={720} /> : p.art === "graph" ? <GraphArt label={p.name.toLowerCase()} /> : <span class="ph display">{p.name.toLowerCase()}</span>}
                    </div>
                    <div class="meta-c">
                      <div class="row">
                        <h3>{p.name}{p.href && <span class="arrow" aria-hidden="true"> ↗</span>}</h3>
                        {p.tag && <span class="tag mono">{p.tag}</span>}
                      </div>
                      <p class="muted">{p.blurb}</p>
                    </div>
                  </Tag>
                );
              })}
            </div>
          </section>
        )}
      </div>
    );
  })}
</Base>

<script is:inline>
  (function () {
    var root = document.documentElement;
    var btns = document.querySelectorAll(".toggle button");
    function sync() {
      btns.forEach(function (b) { b.setAttribute("aria-pressed", String(b.dataset.set === root.dataset.mode)); });
    }
    function set(mode) {
      if (mode === root.dataset.mode) return;
      var apply = function () { root.dataset.mode = mode; sync(); };
      if (document.startViewTransition && !matchMedia("(prefers-reduced-motion: reduce)").matches) document.startViewTransition(apply);
      else apply();
      try { localStorage.setItem("mode", mode); } catch (e) {}
      var u = new URL(location.href);
      if (mode === "work") u.searchParams.delete("mode"); else u.searchParams.set("mode", mode);
      history.replaceState(null, "", u);
    }
    btns.forEach(function (b) { b.addEventListener("click", function () { set(b.dataset.set); }); });
    document.addEventListener("keydown", function (e) {
      if (e.metaKey || e.ctrlKey || e.altKey || /input|textarea|select/i.test(e.target.tagName) || e.target.isContentEditable) return;
      if (e.key === "w") set("work");
      else if (e.key === "l") set("life");
    });
    sync();
  })();
</script>

<style>
  .hero { display: flex; align-items: center; gap: 1.5rem; margin-top: 4.5rem; }
  .photo { width: 88px; height: 88px; border-radius: 50%; object-fit: cover; flex: none; box-shadow: 0 0 0 1px var(--line), 0 0 0 5px var(--bg), 0 0 0 6px var(--line); }
  .who { display: flex; flex-direction: column; align-items: flex-start; gap: 0.7rem; }
  h1 { font-size: clamp(1.9rem, 5vw, 2.4rem); line-height: 1.05; margin: 0; white-space: nowrap; }
  h1 .last { display: inline-block; transition: opacity .35s, max-width .45s cubic-bezier(.3,.7,.2,1); max-width: 8em; overflow: hidden; vertical-align: bottom; }
  :global(:root[data-mode="life"]) h1 .last { opacity: 0; max-width: 0; }
  .photo { transition: filter .5s; }
  :global(:root[data-mode="life"]) .photo { filter: sepia(.35) saturate(1.15) hue-rotate(-12deg) brightness(1.02); }

  .bio { margin: 0; font-size: 1.0625rem; max-width: 30rem; }
  .links { display: flex; flex-wrap: wrap; gap: 0.35rem 1.25rem; margin-top: 1rem; }
  .links a { color: var(--muted); text-decoration: none; }
  .links a:hover { color: var(--accent); }

  .toggle {
    position: relative; display: inline-grid; grid-template-columns: 1fr 1fr;
    padding: 3px; border: 1px solid var(--line); border-radius: 999px; background: var(--card);
  }
  .toggle button {
    position: relative; z-index: 1; font: inherit; color: var(--muted);
    background: none; border: 0; padding: 0.28rem 0.95rem; border-radius: 999px; cursor: pointer;
    transition: color 0.2s;
  }
  .toggle button[aria-pressed="true"] { color: var(--accent); }
  .toggle .pill {
    position: absolute; top: 3px; bottom: 3px; left: 3px; width: calc(50% - 3px);
    border-radius: 999px; background: var(--accent-soft);
    transition: transform 0.3s cubic-bezier(.3,.7,.2,1), background 0.3s;
  }
  :global(:root[data-mode="life"]) .toggle .pill { transform: translateX(100%); }
  @media (prefers-reduced-motion: reduce) { .toggle .pill, .toggle button { transition: none; } }

  .empty { margin: 0; }

  .posts { list-style: none; margin: 0; padding: 0; }
  .posts a { display: flex; align-items: baseline; gap: 0.75rem; padding: 0.3rem 0; text-decoration: none; }
  .posts .t { flex: 0 1 auto; }
  .posts .dots { flex: 1 1 1rem; min-width: 1rem; border-bottom: 1px dotted var(--line); transform: translateY(-0.3em); }
  .posts .meta { flex: none; color: var(--faint); }
  .posts a:hover .t { color: var(--accent); }
  .posts a:hover .dots { border-color: var(--accent); }
  .posts .desc {
    margin: 0; font-size: 0.875rem; line-height: 1.5; max-height: 0; opacity: 0; overflow: hidden;
    transition: max-height .3s cubic-bezier(.3,.7,.2,1), opacity .2s, margin .3s;
  }
  .posts li:hover .desc, .posts li:focus-within .desc { max-height: 3em; opacity: 1; margin: -0.1rem 0 0.4rem; }
  @media (hover: none) { .posts .desc { max-height: none; opacity: 1; margin: -0.1rem 0 0.4rem; } }

  .cards { display: grid; gap: 1rem; }
  .card {
    display: block; text-decoration: none; color: inherit;
    border: 1px solid var(--line); border-radius: 14px; overflow: hidden; background: var(--card);
    transition: border-color 0.2s, transform 0.2s;
  }
  a.card:hover { border-color: var(--accent); transform: translateY(-2px); color: inherit; }
  .thumb {
    aspect-ratio: 2 / 1; background: var(--accent-soft); border-bottom: 1px solid var(--line);
    display: grid; place-items: center; overflow: hidden;
  }
  .thumb img { width: 100%; height: 100%; object-fit: cover; }
  .ph { font-size: clamp(2rem, 8vw, 3.25rem); line-height: 1; color: var(--accent); }
  .meta-c { padding: 0.9rem 1.1rem 1rem; }
  .row { display: flex; justify-content: space-between; align-items: center; gap: 1rem; }
  .meta-c h3 { margin: 0; font-size: 1rem; font-weight: 600; }
  .meta-c p { margin: 0.2rem 0 0; font-size: 0.9375rem; }
  .arrow { color: var(--faint); }
  .tag {
    font-size: 0.6875rem; color: var(--accent); border: 1px solid currentColor;
    padding: 0.1rem 0.5rem; border-radius: 999px; white-space: nowrap; opacity: 0.85;
  }
</style>
